{
  "name": "sugarcommerce/http",
  "version": "1.13.0",
  "description": "A request, a response, a router and a template renderer for plain PHP. Small enough to read in one sitting, complete enough that an application never touches a superglobal.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/http",
  "authors": [ { "name": "David Sherlock", "homepage": "https://arraypress.com/" } ],
  "keywords": ["http", "router", "request", "response", "csp", "templates"],
  "require": {
    "php": ">=8.5",
    "sugarcommerce/network": "^1.0"
  },
  "require-dev": { "phpunit/phpunit": "^13.0" },
  "autoload": { "psr-4": { "SugarCommerce\\Http\\": "src/" } },
  "autoload-dev": { "psr-4": { "SugarCommerce\\Http\\Tests\\": "tests/" } },
  "repositories": [ { "type": "path", "url": "../*", "options": { "symlink": true } } ],
  "scripts": { "test": "phpunit" },
  "config": { "optimize-autoloader": true, "sort-packages": true, "preferred-install": "dist" },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": { "issues": "https://github.com/sugarcommerce/http/issues", "source": "https://github.com/sugarcommerce/http" }
}
